# Local Marketing Genius API configuration
# Required for owner login. Use unique random values.
APP_LOGIN_PASSWORD=change-this-owner-password
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:4173
HOST=127.0.0.1
PORT=8787
MG_DATABASE_PATH=./data/marketing-genius.sqlite

# Optional hosted AI provider. If absent, AI endpoints remain unavailable.
# This is currently a metered proprietary dependency. A local model adapter is a separate migration step.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-6-astra

# Optional Meta publishing credentials. Keep blank unless deliberately configured.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Daily research scan time, UTC. Default matches the existing Worker trigger.
RESEARCH_CRON_UTC=14:00
