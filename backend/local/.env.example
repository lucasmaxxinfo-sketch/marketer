# Local Marketing Genius API configuration
# Required for owner login. Use unique random values.
APP_LOGIN_PASSWORD=change-this-owner-password
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://lucasmaxxinfo-sketch.github.io
# Public API address for the optional Caddy HTTPS profile. A static public IPv4 address works without a custom domain.
API_DOMAIN=YOUR_SERVER_PUBLIC_IP
# Local IPv4 address reserved for the Windows PC when using the private LAN HTTPS profile.
# Set this to the PC's actual reserved LAN address before: docker compose --profile lan up -d
LAN_ADDRESS=192.168.1.50
# Explicit native app origin. Keep this list limited to trusted app origins.
APP_ADDITIONAL_ORIGINS=https://localhost
HOST=127.0.0.1
PORT=8787
MG_DATABASE_PATH=./data/marketing-genius.sqlite

# Local AI provider. Ollama is free/open-source software and runs on your own hardware.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_AI_MODEL=qwen3:4b-instruct

# Self-hosted research search. SearXNG aggregates public search engines; external engines may rate-limit or block requests.
RESEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
# Generate a unique random value before starting the stack.
SEARXNG_SECRET=replace-with-a-long-random-searxng-secret

# Optional hosted OpenAI fallback/provider. Leave blank for a fully local AI and search path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-6-astra

# Optional Meta publishing credentials. Keep blank unless deliberately configured.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Autonomous opportunity research cadence, in hours. Kira scans every four hours by default.
RESEARCH_INTERVAL_HOURS=4
